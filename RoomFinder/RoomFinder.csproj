<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblySearchPaths>../libs;$(AssemblySearchPaths)</AssemblySearchPaths>
    </PropertyGroup>

    <!-- BepInEx 5.x plugin -->
    <PropertyGroup>
        <OutputPath>bin</OutputPath>
        <AssemblyName>RoomFinder</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.27" IncludeAssets="compile" />
        <PackageReference Include="Fody" Version="6.8.0" />
        <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <Private>false</Private>
        </Reference>
        <Reference Include="Photon3Unity3D">
            <Private>false</Private>
        </Reference>
        <Reference Include="PhotonRealtime">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common.UI\Common.UI.csproj" />
    </ItemGroup>

</Project>
